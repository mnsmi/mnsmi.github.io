{
  "manifest_version": 3,
  "name": "Slope Unblocked Game | Gomarus",
  "description": "Gomarus Unblocked Slope Game",
  "sandbox": {
    "pages": [
      "slope.html"
    ]
  },
  "action": {
    "default_title": "__MSG_title__",
    "default_icon": {
      "128": "images/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "js/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "js/*"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "128": "images/icon128.png"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "version": "1.4",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "update_url": "https://edge.microsoft.com/extensionwebstorebase/v1/crx"
}